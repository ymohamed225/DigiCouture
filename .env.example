# ─── PORT & SERVER CONFIG ──────────────────────────────────────────────
PORT=5000
VITE_API_URL=http://localhost:5000/api

# ─── BASE DE DONNÉES MYSQL UNIFIÉE ──────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=digicouture_db

# ─── PASSERELLE API WHATSAPP EN DIRECT (Open-WA / UltraMsg / GreenAPI / Twilio / Meta) ───
# Indiquez vos identifiants pour expédier les OTP et les reçus automatiquement par WhatsApp sur les téléphones clients
WHATSAPP_PROVIDER=OPENWA
WHATSAPP_API_URL=http://localhost:8080/sendText
WHATSAPP_INSTANCE_ID=instance12345
WHATSAPP_API_TOKEN=votre_token_ultramsg_ici
WHATSAPP_SENDER=+2250701020304

# ─── PASSERELLES DE PAIEMENT MOBILE MONEY & WAVE ─────────────────────────
CINETPAY_API_KEY=YOUR_CINETPAY_API_KEY
CINETPAY_SITE_ID=YOUR_CINETPAY_SITE_ID
CINETPAY_SECRET_KEY=YOUR_CINETPAY_SECRET_KEY
WAVE_API_KEY=YOUR_WAVE_API_KEY
