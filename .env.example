# CONFIGURATION GÉNÉRALE DU SERVEUR
NODE_ENV=development
PORT=3000

# CONNEXION À LA BASE DE DONNÉES (MYSQL / PRISMA SSOT)
DATABASE_URL="mysql://root:password@localhost:3306/digicouture_db"

# SÉCURITÉ AUTHENTIFICATION & JETONS JWT
JWT_SECRET=super_secret_jwt_key_digicouture_2026_change_in_production
JWT_REFRESH_SECRET=super_refresh_jwt_key_digicouture_2026_change_in_production

# GUICHET PAIEMENT CINETPAY (MOBILE MONEY & CARTE)
CINETPAY_API_KEY=your_cinetpay_api_key_here
CINETPAY_SITE_ID=your_cinetpay_site_id_here
CINETPAY_SECRET_KEY=your_cinetpay_secret_key_here

# URLS & DEEP LINKS DU SAAS MULTI-TENANT
APP_URL=http://localhost:3000
WEB_URL=http://localhost:5173
MOBILE_DEEP_LINK=digicouture://app

# STOCKAGE OBJET S3 / CDN (ATTACHMENTS & PHOTOS DE COUTURE)
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_BUCKET=digicouture-attachments
STORAGE_ACCESS_KEY=your_storage_access_key_here
STORAGE_SECRET_KEY=your_storage_secret_key_here

# NOTIFICATIONS & OTP WHATSAPP
WHATSAPP_API_URL=https://api.whatsapp.com/v1/messages
WHATSAPP_API_TOKEN=your_whatsapp_bearer_token_here
