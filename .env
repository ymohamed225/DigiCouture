# Configuration Serveur & Base de Données MySQL
PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=digicouture_db
DATABASE_URL="mysql://root:@localhost:3306/digicouture_db"

# 💳 CONFIGURATION API CINETPAY (CÔTE D'IVOIRE / MOBILE MONEY & CARTE)
# Remplacez les valeurs ci-dessous par vos vraies clés fournies sur votre tableau de bord CinetPay.com
CINETPAY_API_KEY=YOUR_CINETPAY_API_KEY
CINETPAY_SITE_ID=YOUR_CINETPAY_SITE_ID
CINETPAY_SECRET_KEY=YOUR_CINETPAY_SECRET_KEY

# URL publique de votre application pour la redirection de paiement
APP_URL=http://localhost:5173

# 🌊 CONFIGURATION API WAVE CHECKOUT (CÔTE D'IVOIRE / WAVE MONEY)
WAVE_API_KEY=YOUR_WAVE_API_KEY
WAVE_API_BASE_URL=https://api.wave.com/v1
WAVE_WEBHOOK_SECRET=YOUR_WAVE_WEBHOOK_SECRET

# 📱 PASSERELLE WHATSAPP AUTOMATIQUE (GRATUITE OU ESSAI)
# Fournisseurs recommandés : GREENAPI (Gratuit) ou ULTRAMSG (Essai gratuit)
WHATSAPP_PROVIDER=GREENAPI
WHATSAPP_API_URL=https://api.green-api.com
WHATSAPP_INSTANCE_ID=votre_instance_id_ici
WHATSAPP_API_TOKEN=votre_token_ici
WHATSAPP_SENDER=+2250700000000

